{
  "name": "@repo/collab-server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "migrate:state:postgres": "tsx src/scripts/migrate-state-to-postgres.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist && printf 'require(\"./apps/collab-server/src/index.js\");\\n' > dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@repo/utils": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "pg": "^8.22.0",
    "redis": "^6.2.0",
    "socket.io": "^4.8.1",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@repo/configs": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.20.4",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3"
  }
}
