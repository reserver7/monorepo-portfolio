{
  "name": "@repo/collab-server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "migrate:state:postgres": "tsx src/scripts/migrate-state-to-postgres.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist && printf 'require(\"./apps/collab-server/src/index.js\");\\n' > dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@repo/utils": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@repo/configs": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15"
  }
}
