generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum IssueSeverity {
  critical
  high
  medium
  low
}

enum IssueStatus {
  new
  analyzing
  in_progress
  resolved
}

enum OpsEnvironment {
  dev
  stage
  prod
}

enum LogSource {
  server
  client
  api
  console
  sentry
}

enum AuthRole {
  admin
  operator
  viewer
}

enum AuthProvider {
  local
  google
  github
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         AuthRole @default(operator)
  authProvider AuthProvider @default(local)
  avatarColor  String @default("#3B82F6")
  notificationPolicy Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId, expiresAt])
}

model Deployment {
  id                  String         @id @default(cuid())
  version             String
  environment         OpsEnvironment
  changelog           String
  status              String         @default("completed")
  owner               String         @default("운영담당자")
  approver            String?
  approvalStatus      String         @default("not_required")
  approvedAt          DateTime?
  overrideReason      String?
  ciUrl               String?
  rollbackStatus      String         @default("not_requested")
  rollbackReason      String?
  rolledBackAt        DateTime?
  scopeTags           Json           @default("[]")
  checklist           Json           @default("[]")
  rollbackCriteria    String?
  monitoringWindowMin Int            @default(60)
  deployedAt          DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  issues              Issue[]

  @@unique([version, environment])
}

model Issue {
  id                    String         @id @default(cuid())
  title                 String
  signature             String         @unique
  severity              IssueSeverity
  status                IssueStatus    @default(new)
  priority              String         @default("P2")
  slaDueAt              DateTime?
  escalationLevel       Int            @default(0)
  acknowledgedAt        DateTime?
  commander             String?
  lastStatusUpdate      String?
  nextUpdateAt          DateTime?
  resolvedAt            DateTime?
  rootCause             String?
  postmortemUrl         String?
  summary               String
  probableCauses        Json
  suggestedActions      Json
  reproductionGuide     String
  assignee              String?
  serviceName           String
  environment           OpsEnvironment
  occurrenceCount       Int            @default(1)
  firstOccurredAt       DateTime
  lastOccurredAt        DateTime
  affectedArea          String?
  deploymentCorrelation String?
  deploymentId          String?
  deployment            Deployment?    @relation(fields: [deploymentId], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  logs                  LogEvent[]
  comments              IssueComment[]

  @@index([environment, serviceName])
  @@index([severity, status])
  @@index([environment, lastOccurredAt])
  @@index([environment, updatedAt])
  @@index([serviceName, lastOccurredAt])
}

model LogEvent {
  id                String    @id @default(cuid())
  issueId           String
  issue             Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  rawMessage        String
  normalizedMessage String
  source            LogSource
  level             String
  occurredAt        DateTime
  endpoint          String?
  page              String?
  userId            String?
  createdAt         DateTime  @default(now())

  @@index([occurredAt])
  @@index([issueId, occurredAt])
}

model LogAnalysisSession {
  id                    String         @id @default(cuid())
  environment           OpsEnvironment
  serviceName           String
  source                LogSource
  requestedBy           String         @default("unknown")
  deploymentVersion     String?
  rawLineCount          Int
  clusterTotalCount     Int
  clusterDisplayedCount Int
  createdIssues         Int            @default(0)
  updatedIssues         Int            @default(0)
  topClusterTitle       String?
  createdAt             DateTime       @default(now())
}

model ServiceMetricEvent {
  id           String         @id @default(cuid())
  serviceName  String
  environment  OpsEnvironment
  requests     Int
  errors       Int
  latencyP95Ms Int?
  occurredAt   DateTime
  createdAt    DateTime       @default(now())

  @@index([serviceName, environment, occurredAt])
  @@index([environment, occurredAt])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime @default(now())
}

model QaScenario {
  id                String   @id @default(cuid())
  featureName       String
  changedScreens    String
  relatedApis       String
  releaseNote       String
  generatedCases    Json
  riskPoints        Json
  regressionTargets Json
  audience          String
  status            String   @default("draft")
  owner             String   @default("QA 담당자")
  reviewer          String?
  executionStatus   String   @default("not_started")
  executedAt        DateTime?
  notes             String?
  createdAt         DateTime @default(now())
}

model OpsAlert {
  id          String         @id @default(cuid())
  level       IssueSeverity
  title       String
  message     String
  source      String
  link        String?
  readAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model OpsNotificationDelivery {
  id            String   @id @default(cuid())
  alertId       String
  channel       String
  status        String   @default("pending")
  attempts      Int      @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([alertId, channel])
  @@index([status, nextAttemptAt])
}

model OpsReportSnapshot {
  id                String         @id @default(cuid())
  title             String
  environment       OpsEnvironment?
  riskLevel         String
  executiveSummary  String
  technicalSummary  String
  shareText         String
  generatedBy       String         @default("system")
  pinned            Boolean        @default(false)
  sharedAt          DateTime?
  generatedAt       DateTime       @default(now())
  createdAt         DateTime       @default(now())
  actions           OpsReportAction[]
}

model OpsReportAction {
  id          String   @id @default(cuid())
  snapshotId  String
  snapshot    OpsReportSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  actionKey   String
  title       String
  description String
  owner       String
  priority    String
  dueAt       DateTime?
  completedAt DateTime?
  completedBy String?
  reopenedReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([snapshotId, actionKey])
  @@index([snapshotId, completedAt])
}

model OpsSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  category    String   @default("general")
  riskLevel   String   @default("low")
  editable    Boolean  @default(true)
  updatedBy   String   @default("system")
  changeReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([riskLevel])
}

model OpsLogSavedView {
  id          String   @id @default(cuid())
  name        String
  owner       String
  visibility  String   @default("team")
  severity    String   @default("all")
  query       String   @default("")
  sort        String   @default("countDesc")
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visibility, updatedAt])
  @@index([owner, updatedAt])
}

model OpsAuditLog {
  id          String   @id @default(cuid())
  actor       String   @default("system")
  action      String
  targetType  String
  targetId    String?
  severity    String   @default("info")
  summary     String
  beforeValue Json?
  afterValue  Json?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actor])
  @@index([action])
  @@index([severity])
  @@index([createdAt])
}
