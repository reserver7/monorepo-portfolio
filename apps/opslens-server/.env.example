PORT=4100
NODE_ENV=development
# 런타임 연결(pooled)
DATABASE_URL=postgresql://portfolio:portfolio-local-password@127.0.0.1:5433/opslens?schema=public
# 마이그레이션 연결(direct)
DIRECT_DATABASE_URL=postgresql://portfolio:portfolio-local-password@127.0.0.1:5433/opslens?schema=public
AUTH_JWT_SECRET=replace-with-32chars-or-more-secret
AUTH_ACCESS_TOKEN_TTL_SEC=28800
AUTH_BRIDGE_SECRET=replace-with-32chars-or-more-secret
OPS_INGESTION_KEY=replace-with-32chars-or-more-ingestion-key
OPS_INGESTION_MAX_CHARS=1000000
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY_MS=700
AI_CACHE_TTL_MS=120000
OPS_CACHE_DASHBOARD_SUMMARY_TTL_MS=30000
OPS_CACHE_DASHBOARD_SUMMARY_MAX=200
OPS_CACHE_DASHBOARD_BRIEFING_TTL_MS=90000
OPS_CACHE_DASHBOARD_BRIEFING_MAX=200
OPS_CACHE_DEPLOYMENT_IMPACT_TTL_MS=30000
OPS_CACHE_DEPLOYMENT_IMPACT_MAX=200
OPS_CACHE_ISSUE_LIST_TTL_MS=15000
OPS_CACHE_ISSUE_LIST_MAX=300
OPS_CACHE_QA_SCENARIO_TTL_MS=15000

# -----------------------------
# Recommended cache tuning
# -----------------------------
# DEV (faster feedback, less stale)
# OPS_CACHE_DASHBOARD_SUMMARY_TTL_MS=15000
# OPS_CACHE_DASHBOARD_SUMMARY_MAX=100
# OPS_CACHE_DASHBOARD_BRIEFING_TTL_MS=30000
# OPS_CACHE_DASHBOARD_BRIEFING_MAX=100
# OPS_CACHE_DEPLOYMENT_IMPACT_TTL_MS=15000
# OPS_CACHE_DEPLOYMENT_IMPACT_MAX=100
# OPS_CACHE_ISSUE_LIST_TTL_MS=10000
# OPS_CACHE_ISSUE_LIST_MAX=200
# OPS_CACHE_QA_SCENARIO_TTL_MS=10000

# PROD (stability + lower DB load)
# OPS_CACHE_DASHBOARD_SUMMARY_TTL_MS=30000
# OPS_CACHE_DASHBOARD_SUMMARY_MAX=500
# OPS_CACHE_DASHBOARD_BRIEFING_TTL_MS=90000
# OPS_CACHE_DASHBOARD_BRIEFING_MAX=500
# OPS_CACHE_DEPLOYMENT_IMPACT_TTL_MS=30000
# OPS_CACHE_DEPLOYMENT_IMPACT_MAX=300
# OPS_CACHE_ISSUE_LIST_TTL_MS=15000
# OPS_CACHE_ISSUE_LIST_MAX=500
# OPS_CACHE_QA_SCENARIO_TTL_MS=15000
