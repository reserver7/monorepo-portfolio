# Render production: never use localhost or 127.0.0.1 values here.
# DATABASE_URL uses Neon pooled host; DIRECT_DATABASE_URL uses Neon direct host.
NODE_ENV=production
PORT=4100
CORS_ORIGINS=https://opslens.example.com
DATABASE_URL=postgresql://<pooled-user>:<password>@<pooled-host>/<database>?sslmode=require
DIRECT_DATABASE_URL=postgresql://<direct-user>:<password>@<direct-host>/<database>?sslmode=require
AUTH_JWT_SECRET=replace-with-a-unique-32-character-or-longer-secret
AUTH_BRIDGE_SECRET=replace-with-a-unique-32-character-or-longer-secret
OPS_INGESTION_KEY=replace-with-a-unique-32-character-or-longer-secret
OPS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
