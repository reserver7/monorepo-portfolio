{
  "name": "@repo/opslens-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @repo/opslens-server exec prisma generate",
    "dev": "nodemon --watch src --ext ts --exec \"node --loader ts-node/esm src/index.ts\"",
    "build": "pnpm --filter @repo/opslens-server exec prisma generate && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --filter @repo/opslens-server exec prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "DATABASE_URL=postgresql://test:test@localhost:5432/opslens DIRECT_DATABASE_URL=postgresql://test:test@localhost:5432/opslens tsx --test src/modules/auth/*.test.ts src/modules/ops/*.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "graphql": "^17.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repo/configs": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^26.4.0",
    "nodemon": "^3.1.10",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13"
  }
}
